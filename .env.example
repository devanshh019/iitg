# HACKOS Environment Configuration
# Copy this file to .env and configure secrets accordingly.

# Environment Mode
ENVIRONMENT=production
DEBUG=false
APP_NAME=HACKOS
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL source of truth)
DATABASE_URL=postgresql://postgres@localhost:5433/hackos
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/hackos_test

# Authentication & Security
SECRET_KEY=hackos_super_secret_jwt_hmac_signing_key_change_in_prod_min_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-Level PII Encryption Key (Fernet 32-byte urlsafe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=s9aF39B6J7-f4eS7t1zFwR2h8kL0mN9pQ4rS6uV8wX0=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://hackos.vercel.app

# Optional Sentry Monitoring
SENTRY_DSN=

# Optional SMTP Email Configuration (Falls back to Console/Mock in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=mission-control@hackos.local
SMTP_FROM_NAME=HACKOS Mission Control
